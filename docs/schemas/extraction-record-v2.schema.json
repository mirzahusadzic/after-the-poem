{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:after-the-poem:extraction-record-v2",
  "title": "After the Poem Extraction Record v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "extraction_id",
    "run_id",
    "identities",
    "extractor",
    "sources",
    "items",
    "unknowns"
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "safeId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "start",
        "end"
      ],
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "lines"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "lines": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "statement",
        "citations",
        "ambiguity"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/safeId"
        },
        "kind": {
          "enum": [
            "claim",
            "actor",
            "relationship",
            "condition",
            "boundary",
            "question",
            "continuation",
            "ambiguity"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "ambiguity": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8000
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": 2
    },
    "extraction_id": {
      "$ref": "#/$defs/safeId"
    },
    "run_id": {
      "$ref": "#/$defs/safeId"
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_sha256",
        "corpus_sha256",
        "candidate_sha256"
      ],
      "properties": {
        "prompt_sha256": {
          "$ref": "#/$defs/digest"
        },
        "corpus_sha256": {
          "$ref": "#/$defs/digest"
        },
        "candidate_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gateway",
        "model",
        "reasoning",
        "codex_version",
        "router_revision",
        "pipeline_sha256",
        "answer_sha256",
        "receipt_sha256"
      ],
      "properties": {
        "gateway": {
          "const": "codex-unified-model-router"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reasoning": {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "codex_version": {
          "type": "string",
          "minLength": 1
        },
        "router_revision": {
          "$ref": "#/$defs/digest"
        },
        "pipeline_sha256": {
          "$ref": "#/$defs/digest"
        },
        "answer_sha256": {
          "$ref": "#/$defs/digest"
        },
        "receipt_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    }
  },
  "description": "Schema 2 stores exact inclusive line ranges; quotation text is resolved from the hash-pinned retained sources."
}
