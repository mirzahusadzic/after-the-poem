{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:after-the-poem:presentation-record-v1",
  "title": "After the Poem Presentation Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "presentation_id", "evaluation_id", "run_id", "identities", "label", "title", "summary", "status", "score", "criteria", "findings", "usage"],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "safeId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"},
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "start", "end", "quote"],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "start": {"type": "integer", "minimum": 1},
        "end": {"type": "integer", "minimum": 1},
        "quote": {"type": "string", "minLength": 1}
      }
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "presentation_id": {"$ref": "#/$defs/safeId"},
    "evaluation_id": {"$ref": "#/$defs/safeId"},
    "run_id": {"$ref": "#/$defs/safeId"},
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation_sha256", "extraction_sha256", "scoring_policy_sha256"],
      "properties": {
        "evaluation_sha256": {"$ref": "#/$defs/digest"},
        "extraction_sha256": {"$ref": "#/$defs/digest"},
        "scoring_policy_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "label": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1, "maxLength": 16000},
    "status": {"enum": ["profile", "scored", "unresolved", "review"]},
    "score": {"type": ["number", "null"]},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "label", "question", "scale", "samples", "aggregation", "outcome"],
        "properties": {
          "node_id": {"$ref": "#/$defs/safeId"},
          "label": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "scale": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {"type": "number"}
          },
          "samples": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
            "required": ["sample", "outcome", "verdict", "seed_span", "rationale", "citations", "counter_citations"],
              "properties": {
                "sample": {"type": "integer", "minimum": 1},
                "outcome": {"$ref": "#/$defs/safeId"},
                "verdict": {"type": "string", "minLength": 1, "maxLength": 400},
                "seed_span": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {"type": "integer", "minimum": 1}
                },
                "rationale": {"type": "string", "minLength": 1},
                "citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
                "counter_citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}}
              }
            }
          },
          "aggregation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["strategy", "sample_count", "outcome", "agreement", "distinct_outcomes"],
            "properties": {
              "strategy": {"enum": ["unanimous", "majority", "quorum"]},
              "sample_count": {"type": "integer", "minimum": 1},
              "outcome": {"$ref": "#/$defs/safeId"},
              "agreement": {"type": "number", "minimum": 0, "maximum": 1},
              "distinct_outcomes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/safeId"}}
            }
          },
          "outcome": {
            "type": "object",
            "additionalProperties": false,
            "required": ["terminal_id", "status", "score", "rationale"],
            "properties": {
              "terminal_id": {"$ref": "#/$defs/safeId"},
              "status": {"enum": ["scored", "unresolved", "review"]},
              "score": {"type": ["number", "null"]},
              "rationale": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "findings": {"type": "array", "maxItems": 256, "items": {"type": "string", "minLength": 1}},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calls", "input_tokens", "output_tokens", "cost"],
      "properties": {
        "calls": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": ["integer", "null"]},
        "output_tokens": {"type": ["integer", "null"]},
        "cost": {"type": ["object", "null"]}
      }
    }
  }
}
