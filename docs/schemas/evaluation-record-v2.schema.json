{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:after-the-poem:evaluation-record-v2",
  "title": "After the Poem Evaluation Record v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_id",
    "run_id",
    "identities",
    "gateway",
    "judgments",
    "aggregations",
    "outcomes",
    "presentation",
    "usage"
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "safeId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "start",
        "end"
      ],
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": 2
    },
    "evaluation_id": {
      "$ref": "#/$defs/safeId"
    },
    "run_id": {
      "$ref": "#/$defs/safeId"
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_sha256",
        "corpus_sha256",
        "candidate_sha256",
        "rubric_sha256",
        "extraction_sha256",
        "scoring_policy_sha256"
      ],
      "properties": {
        "prompt_sha256": {
          "$ref": "#/$defs/digest"
        },
        "corpus_sha256": {
          "$ref": "#/$defs/digest"
        },
        "candidate_sha256": {
          "$ref": "#/$defs/digest"
        },
        "rubric_sha256": {
          "$ref": "#/$defs/digest"
        },
        "extraction_sha256": {
          "$ref": "#/$defs/digest"
        },
        "scoring_policy_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "model",
        "reasoning",
        "codex_version",
        "router_revision",
        "pipeline_sha256"
      ],
      "properties": {
        "name": {
          "const": "codex-unified-model-router"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reasoning": {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "codex_version": {
          "type": "string",
          "minLength": 1
        },
        "router_revision": {
          "$ref": "#/$defs/digest"
        },
        "pipeline_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "judgments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "sample",
          "outcome",
          "verdict",
          "seed_span",
          "citations",
          "counter_citations",
          "rationale",
          "answer_sha256",
          "receipt_sha256",
          "attempt",
          "confidence"
        ],
        "properties": {
          "node_id": {
            "$ref": "#/$defs/safeId"
          },
          "sample": {
            "type": "integer",
            "minimum": 1
          },
          "outcome": {
            "$ref": "#/$defs/safeId"
          },
          "verdict": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "seed_span": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "citations": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "$ref": "#/$defs/citation"
            }
          },
          "counter_citations": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "$ref": "#/$defs/citation"
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "answer_sha256": {
            "$ref": "#/$defs/digest"
          },
          "receipt_sha256": {
            "$ref": "#/$defs/digest"
          },
          "attempt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        }
      }
    },
    "aggregations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "strategy",
          "sample_count",
          "outcome",
          "agreement",
          "distinct_outcomes"
        ],
        "properties": {
          "node_id": {
            "$ref": "#/$defs/safeId"
          },
          "strategy": {
            "enum": [
              "unanimous",
              "majority",
              "quorum"
            ]
          },
          "sample_count": {
            "type": "integer",
            "minimum": 1
          },
          "outcome": {
            "$ref": "#/$defs/safeId"
          },
          "agreement": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "distinct_outcomes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/safeId"
            }
          }
        }
      }
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "status",
          "score",
          "rationale"
        ],
        "properties": {
          "node_id": {
            "$ref": "#/$defs/safeId"
          },
          "status": {
            "enum": [
              "scored",
              "unresolved",
              "review"
            ]
          },
          "score": {
            "type": [
              "number",
              "null"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          }
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "title",
        "summary",
        "findings"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "findings": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calls",
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "reasoning_output_tokens",
        "cost"
      ],
      "properties": {
        "calls": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "cost": {
          "type": [
            "object",
            "null"
          ]
        },
        "cached_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reasoning_output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  },
  "description": "Schema 2 records evidence-session scoreflow: citations are exact line ranges resolved from hash-pinned sources, every judgment carries its attempt and reader confidence, and usage counts every launched turn."
}
